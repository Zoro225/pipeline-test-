# Copy this file to .env and fill in real values before running the app.

# SQLite database file (created automatically on first migration).
DATABASE_URL="file:./dev.db"

# Generate with: openssl rand -base64 32
NEXTAUTH_SECRET="replace-with-a-random-secret"

# Must match the exact URL you use to access the app in the browser.
# If you're testing from other devices on your network, use your machine's
# LAN IP here (e.g. http://192.168.0.101:3000) instead of localhost, and
# then always access the app via that same address.
NEXTAUTH_URL="http://localhost:3000"
